# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python exporter caches
__pycache__/

# Private review records: kept locally, never published
SPRINT_17_REPORT.md
exporter/APPROVAL.md

# Unapproved holdings exports (published only after owner approval via exporter/publish_holdings.py)
src/data/holdings/candidates/
SPRINT_18_REPORT.md

# Downloaded public sources for the company-name mapping (re-derivable; hashes recorded in exporter/company_names.json)
exporter/name_sources/

# Unapproved dataset re-exports (published only after owner approval via exporter/publish_dataset.py)
src/data/candidates/
